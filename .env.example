JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JARVIS_OWNER_USERNAME=owner
JARVIS_OWNER_PASSWORD_HASH=pbkdf2_sha256$390000$replace_salt$replace_hash
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=30
DATABASE_URL=sqlite:///./jarvis.db
MEMORY_WINDOW_MESSAGES=12
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# For Supabase Postgres, replace DATABASE_URL with:
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# NOTE: DATABASE_URL is also used by the LangGraph Postgres checkpointer
# for persistent conversational memory (checkpoints, checkpoint_writes tables).

# ── Jarvis System Control Settings ──
# Directory for action audit logs (default: ./logs)
JARVIS_LOG_DIR=./logs
# Directory for screenshots (default: ./screenshots)
JARVIS_SCREENSHOT_DIR=./screenshots
